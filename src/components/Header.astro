---
import { site } from '../config/site';
import { mainNav } from '../config/nav';
import { url, isCurrent } from '../lib/url';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32" role="presentation">
          <defs>
            <linearGradient id="brandGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#5AA9E6"></stop>
              <stop offset="55%" stop-color="#8FA2EE"></stop>
              <stop offset="100%" stop-color="#A9A0F0"></stop>
            </linearGradient>
          </defs>
          <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#brandGrad)"></rect>
          <path
            d="M10 9v14M10 16.5l7-7.5M10 16l7 7"
            stroke="#fff"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
          <circle cx="22.5" cy="22" r="2.2" fill="#fff" opacity=".9"></circle>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">{site.nameEn}</span>
        <span class="brand__tagline">小さな困りごとを、形に</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="メインメニュー">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class:list={['nav-link', { 'is-current': isCurrent(currentPath, item.href) }]}
                aria-current={isCurrent(currentPath, item.href) ? 'page' : undefined}
              >
                <span class="nav-link__ja">{item.label}</span>
                <span class="nav-link__en">{item.labelEn}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary header-cta" href={url('/estimate')}>見積もる</a>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">メニューを開く</span>
    </button>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="メインメニュー（モバイル）" hidden>
    <ul>
      {
        mainNav.map((item) => (
          <li>
            <a href={url(item.href)} class="nav-mobile__link">
              <span>{item.label}</span>
              <span class="nav-mobile__en">{item.labelEn}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="nav-mobile__note">{site.availability.hours}</p>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    border-bottom: 1px solid rgba(230, 232, 239, 0.9);
  }

  .site-header__inner {
    max-width: var(--w-page);
    margin-inline: auto;
    padding-inline: var(--pad-x);
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--c-text);
    margin-right: auto;
    padding-block: 0.5rem;
  }

  .brand__mark {
    display: block;
    line-height: 0;
    filter: drop-shadow(0 4px 10px rgba(47, 125, 225, 0.28));
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand__name {
    font-family: var(--font-en);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
  }

  .brand__tagline {
    font-size: 0.6875rem;
    color: var(--c-text-mute);
    letter-spacing: 0.02em;
  }

  /* --- デスクトップナビ --- */
  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 0.45rem 0.75rem;
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--c-text-sub);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .nav-link:hover {
    background: rgba(90, 169, 230, 0.1);
    color: var(--c-blue-ink);
  }

  .nav-link.is-current {
    color: var(--c-blue-ink);
    background: rgba(90, 169, 230, 0.12);
  }

  .nav-link__ja {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .nav-link__en {
    font-family: var(--font-en);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-mute);
    line-height: 1.2;
  }

  .header-cta {
    display: none;
    min-height: 40px;
    padding: 0.5em 1.15em;
    font-size: 0.8125rem;
  }

  /* --- モバイル開閉ボタン --- */
  .nav-toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.8);
  }

  .nav-toggle__bars {
    display: grid;
    gap: 5px;
  }

  .nav-toggle__bars span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-text);
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* --- モバイルメニュー --- */
  .nav-mobile {
    border-top: 1px solid var(--c-line);
    background: rgba(255, 255, 255, 0.97);
    padding: var(--sp-3) var(--pad-x) var(--sp-5);
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .nav-mobile ul {
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .nav-mobile__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    min-height: 52px;
    padding: 0.75rem 0.25rem;
    text-decoration: none;
    color: var(--c-text);
    font-weight: 700;
    border-bottom: 1px solid var(--c-line);
  }

  .nav-mobile__en {
    font-family: var(--font-en);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-mute);
    font-weight: 600;
  }

  .nav-mobile__note {
    margin-top: var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--c-text-mute);
  }

  @media (min-width: 900px) {
    .nav-desktop,
    .header-cta {
      display: flex;
    }

    .nav-toggle,
    .nav-mobile {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  if (toggle && menu) {
    const label = toggle.querySelector('.visually-hidden');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (label) label.textContent = open ? 'メニューを閉じる' : 'メニューを開く';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // リンクを押したら閉じる（同一ページ内リンクでも閉じる）
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        (toggle as HTMLButtonElement).focus();
      }
    });
  }
</script>
