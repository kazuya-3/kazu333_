---
/**
 * 画像が用意されていない実績・商品のための抽象カバー。
 * slug から決まった形が描かれるため、同じ項目は常に同じ見た目になります。
 * 画像を用意したら、データ側に thumbnail / preview を設定すれば置き換わります。
 */

interface Props {
  seed: string;
  accent?: 'system' | 'document' | 'creative' | 'ai' | 'neutral';
  ratio?: string;
  label?: string;
}

const { seed, accent = 'system', ratio = '16 / 10', label } = Astro.props;

const palettes: Record<string, [string, string, string]> = {
  system: ['#e4f0fd', '#bcd9f7', '#2f7de1'],
  document: ['#efedfd', '#d3ccf6', '#7a6fdc'],
  creative: ['#ffeeec', '#ffd3cd', '#e8604f'],
  ai: ['#e4f7f3', '#bcebe1', '#35a894'],
  neutral: ['#eef1f6', '#dbe1ea', '#5a6478'],
};

const [bg, mid, ink] = palettes[accent] ?? palettes.system;

// slug から決定的に数値を取り出す
function hash(text: string): number {
  let h = 2166136261;
  for (let i = 0; i < text.length; i += 1) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return Math.abs(h);
}

const h = hash(seed);
const pick = (index: number, range: number) => Math.floor(h / 7 ** index) % range;

const cx = 30 + pick(1, 45);
const cy = 25 + pick(2, 45);
const r = 22 + pick(3, 18);
const rot = pick(4, 90) - 45;
const variant = pick(5, 3);
const uid = `cover-${seed.replace(/[^a-z0-9]/gi, '')}`;
---

<div class="cover" style={`--ratio:${ratio}`} role="img" aria-label={label ?? '画像は準備中です'}>
  <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id={`${uid}-g`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={bg}></stop>
        <stop offset="100%" stop-color={mid}></stop>
      </linearGradient>
      <radialGradient id={`${uid}-r`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#fff" stop-opacity=".85"></stop>
        <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <rect width="160" height="100" fill={`url(#${uid}-g)`}></rect>
    <circle cx={cx} cy={cy} r={r} fill={`url(#${uid}-r)`}></circle>

    {
      variant === 0 && (
        <g transform={`rotate(${rot} 110 55)`} opacity="0.5">
          <rect x="86" y="30" width="52" height="52" rx="14" fill="none" stroke={ink} stroke-width="1.4" />
          <rect x="98" y="42" width="28" height="28" rx="8" fill={ink} opacity="0.16" />
        </g>
      )
    }
    {
      variant === 1 && (
        <g opacity="0.45">
          <circle cx="112" cy="52" r="30" fill="none" stroke={ink} stroke-width="1.4" />
          <circle cx="112" cy="52" r="18" fill="none" stroke={ink} stroke-width="1.4" opacity=".7" />
          <circle cx="112" cy="52" r="6" fill={ink} opacity=".25" />
        </g>
      )
    }
    {
      variant === 2 && (
        <g opacity="0.42" transform={`rotate(${rot / 3} 110 55)`}>
          <path d="M84 78 L106 34 L128 78 Z" fill="none" stroke={ink} stroke-width="1.4" />
          <path d="M96 78 L112 46 L128 78" fill={ink} opacity=".14" />
        </g>
      )
    }

    <g opacity="0.3" stroke={ink} stroke-width="1">
      <line x1="0" y1="82" x2="160" y2="70"></line>
      <line x1="0" y1="90" x2="160" y2="80" opacity=".6"></line>
    </g>
  </svg>
  <span class="cover__tag">画像は準備中</span>
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--c-surface-soft);
  }

  .cover svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .cover__tag {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.2em 0.7em;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.85);
    color: var(--c-text-mute);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
</style>
