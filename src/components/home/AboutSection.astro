---
import SectionHeading from '../SectionHeading.astro';
import { about, career, skillGroups, tools } from '../../config/about';
import { site } from '../../config/site';
---

<section class="section about-section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading eyebrow="About" title={about.heading} id="about-title" />

    <div class="about-section__body">
      <div class="about-section__main reveal">
        <div class="about-section__intro">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <dl class="about-section__career">
          {
            career.map((row) => (
              <div>
                <dt>{row.period}</dt>
                <dd>{row.body}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="about-values">
          {
            about.values.map((value) => (
              <li>
                <h3>{value.title}</h3>
                <p>{value.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="about-section__side reveal">
        <div class="about-card">
          <h3 class="about-card__title">できること</h3>
          {
            skillGroups.map((group) => (
              <div class="skill-group">
                <p class:list={['skill-group__label', `is-${group.accent}`]}>{group.label}</p>
                <ul class="tag-row">
                  {group.items.map((item) => (
                    <li class="badge">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="about-card">
          <h3 class="about-card__title">よく使うツール</h3>
          <ul class="tag-row">
            {tools.map((tool) => <li class="badge">{tool}</li>)}
          </ul>
        </div>

        <div class="about-card about-card--hours">
          <h3 class="about-card__title">対応時間</h3>
          <p class="about-card__hours">{site.availability.hours}</p>
          <p class="about-card__note">{site.availability.note}</p>
          <p class="about-card__note">お返事の目安：{site.contact.replyTime}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-section__body {
    margin-top: var(--sp-8);
    display: grid;
    gap: var(--sp-8);
  }

  .about-section__intro {
    display: grid;
    gap: var(--sp-4);
    font-size: var(--fs-lead);
    color: var(--c-text-sub);
    max-width: 40em;
  }

  .about-section__career {
    margin-top: var(--sp-8);
    display: grid;
    gap: 0;
    border-top: 1px solid var(--c-line);
  }

  .about-section__career > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--c-line);
  }

  .about-section__career dt {
    font-size: var(--fs-sm);
    font-weight: 800;
    color: var(--c-blue-ink);
  }

  .about-section__career dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--c-text-sub);
  }

  .about-values {
    margin-top: var(--sp-8);
    display: grid;
    gap: var(--sp-4);
    list-style: none;
  }

  .about-values li {
    padding: var(--sp-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    box-shadow: var(--sh-sm);
  }

  .about-values h3 {
    font-size: 1rem;
    color: var(--c-text);
  }

  .about-values p {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--c-text-sub);
    line-height: 1.85;
  }

  .about-section__side {
    display: grid;
    gap: var(--sp-4);
    align-content: start;
  }

  .about-card {
    padding: var(--sp-5);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--c-line);
    box-shadow: var(--sh-sm);
  }

  .about-card__title {
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    color: var(--c-text-mute);
    margin-bottom: var(--sp-4);
  }

  .skill-group + .skill-group {
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--c-line);
  }

  .skill-group__label {
    font-size: var(--fs-xs);
    font-weight: 800;
    margin-bottom: var(--sp-2);
  }

  .skill-group__label.is-system {
    color: var(--c-cat-system);
  }
  .skill-group__label.is-document {
    color: var(--c-cat-document);
  }
  .skill-group__label.is-creative {
    color: var(--c-cat-creative);
  }

  .about-card--hours {
    background: linear-gradient(140deg, rgba(240, 247, 255, 0.95), rgba(244, 240, 255, 0.9));
    border-color: rgba(90, 169, 230, 0.28);
  }

  .about-card__hours {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--c-blue-ink);
  }

  .about-card__note {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--c-text-sub);
    line-height: 1.8;
  }

  @media (min-width: 620px) {
    .about-values {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    }
  }

  @media (min-width: 900px) {
    .about-section__body {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
      gap: var(--sp-12);
      align-items: start;
    }
  }
</style>
