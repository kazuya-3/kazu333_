---
/**
 * 全ページ共通のレイアウト。
 * SEO（title / description / canonical / OGP / X カード）と
 * JSON-LD、ヘッダー・フッター・モバイル固定CTAをまとめています。
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import BackgroundDecor from '../components/BackgroundDecor.astro';
import { site } from '../config/site';
import { url, absoluteUrl } from '../lib/url';

interface Props {
  /** ページ固有のタイトル。省略するとサイト既定のタイトルを使います。 */
  title?: string;
  description?: string;
  /** OGP 画像のパス（public 配下） */
  image?: string;
  /** og:type */
  type?: 'website' | 'article';
  /** 追加の JSON-LD */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** noindex にする（404 など） */
  noindex?: boolean;
  /** ページ下部の相談CTAを出すか */
  showContactCta?: boolean;
}

const {
  title,
  description = site.seo.description,
  image = site.seo.ogImage,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? site.seo.titleTemplate.replace('%s', title) : site.seo.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const ogImage = absoluteUrl(image, Astro.site);
const currentPath = Astro.url.pathname;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.seo.description,
  url: absoluteUrl('/', Astro.site),
  areaServed: { '@type': 'Country', name: '日本' },
  availableLanguage: '日本語',
  priceRange: '¥3,000〜',
  serviceType: [
    'システムの軽微な修正',
    'データ整理・SQL作成',
    '資料・マニュアル作成',
    'SNS・配信素材制作',
    'AI活用・プロンプト設計',
  ],
};

const jsonLdList = [organizationLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="ja" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fbfaf8" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.seo.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {site.seo.twitterHandle && <meta name="twitter:site" content={site.seo.twitterHandle} />}

    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <script is:inline>
      // JS が動く環境であることを示す（出現アニメーションの保険）
      document.documentElement.classList.remove('no-js');
    </script>

    {
      jsonLdList.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <BackgroundDecor />
    <Header currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileActionBar currentPath={currentPath} />

    <script>
      // スクロールに合わせた軽い出現アニメーション。
      // prefers-reduced-motion が有効なときは何もしない。
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      function setupReveal() {
        const targets = document.querySelectorAll<HTMLElement>('.reveal');
        if (reduce.matches || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => observer.observe(el));
      }

      setupReveal();
      document.addEventListener('astro:after-swap', setupReveal);
    </script>
  </body>
</html>
