# Copy this file to .env.local and fill in the real values.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time.
# Never put secret keys (Stripe secret keys, DB passwords, etc.) here.

# Public URL of your deployed site (used for canonical + OpenGraph).
NEXT_PUBLIC_SITE_URL=https://angryreviewrescue.com

# Hosted payment links — Stripe Payment Link, Gumroad, Lemon Squeezy, etc.
# Leave empty during early development; the /checkout/* pages will show a
# friendly placeholder instead of breaking.
NEXT_PUBLIC_FOUNDER_CHECKOUT_URL=
NEXT_PUBLIC_AGENCY_CHECKOUT_URL=
