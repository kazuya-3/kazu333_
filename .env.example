# ------------------------------------------------------------------
# KAZU WORKS 環境変数サンプル
# このファイルを .env としてコピーし、必要な値だけ設定してください。
# .env はコミットしないでください（.gitignore 済み）。
#
# すべて未設定でも開発サーバー・本番ビルドは動作します。
# 未設定時は問い合わせフォームが「モック送信」になり、購入リンクは
# 「準備中」表示に切り替わります（壊れたリンクは出ません）。
# ------------------------------------------------------------------

# --- 公開 URL / ベースパス（ビルド時に使用） -----------------------
# GitHub Pages のプロジェクトページ（例: https://user.github.io/repo/）の場合
SITE_URL=https://kazuya-3.github.io
BASE_PATH=/kazu333_
# 独自ドメインの場合は次のように設定します
# SITE_URL=https://example.com
# BASE_PATH=/

# --- 問い合わせフォームの送信先 ------------------------------------
# mock     : 送信せず成功扱い（開発用・既定値）
# formspree: 外部フォームサービス Formspree へ送信
# endpoint : 自前の API エンドポイントへ送信（将来拡張用）
PUBLIC_CONTACT_PROVIDER=mock

# PUBLIC_CONTACT_PROVIDER=formspree のとき必須
# https://formspree.io/ で作成したフォームのエンドポイント URL
PUBLIC_FORMSPREE_ENDPOINT=

# PUBLIC_CONTACT_PROVIDER=endpoint のとき必須
# 例: https://api.example.com/contact
PUBLIC_CONTACT_ENDPOINT=

# 添付ファイルの上限（MB）と許可拡張子（カンマ区切り）
PUBLIC_UPLOAD_MAX_MB=10
PUBLIC_UPLOAD_ACCEPT=.png,.jpg,.jpeg,.gif,.pdf,.zip,.xlsx,.csv,.txt,.docx,.pptx

# --- 応援チップの外部決済リンク ------------------------------------
# 未設定の場合、応援セクションは「準備中」表示になります。
# Stripe Payment Links / PayPal.me / Buy Me a Coffee などの URL を指定します。
PUBLIC_TIP_URL_300=
PUBLIC_TIP_URL_500=
PUBLIC_TIP_URL_1000=
PUBLIC_TIP_URL_CUSTOM=

# --- アクセス解析（任意・未設定なら読み込みません） ----------------
# 例: Google Analytics 4 の測定 ID
PUBLIC_ANALYTICS_ID=

# ------------------------------------------------------------------
# 注意:
# - PUBLIC_ が付く変数はブラウザへ露出します。秘密鍵を入れないでください。
# - 決済のシークレットキーや管理用トークンはこのサイトでは扱いません。
#   決済は外部サービスのページへリンクする方式です。
# ------------------------------------------------------------------
